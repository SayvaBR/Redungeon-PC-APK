<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <TargetFramework>net10.0</TargetFramework>

    <RollForward>Major</RollForward>

    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <!-- Build only the explicit PC manifest, never Android.mgcb as PC content. -->
    <EnableMGCBItems>false</EnableMGCBItems>

    <!--  -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Facilita o diagnóstico -->
    <MonoGameMGCBAdditionalArguments></MonoGameMGCBAdditionalArguments>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icon.ico"/>
    <None Remove="Icon.bmp"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico"/>
    <EmbeddedResource Include="Icon.bmp"/>
  </ItemGroup>

  <!-- Os contratos executáveis vivem em um projeto separado e não fazem
       parte do binário do jogo. -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs"/>
    <Compile Remove="Android\**\*.cs"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Fixar as versões -->
    <PackageReference Include="MonoGame.Framework.DesktopGL"
                      Version="3.8.5.1"/>

    <PackageReference Include="MonoGame.Content.Builder.Task"
                      Version="3.8.5.1"/>
  </ItemGroup>

  <!-- TODO: fix extract process for SDL2 library-->
  <Target Name="ExtractSDL2ToRoot" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- 1. Исключаем все варианты SDL2 из внутриисполняемого SingleFile -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').Contains('SDL2'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>

      <!-- 2. Берем SDL2 строго из папки runtimes и копируем прямо в корень рядом с .exe -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').Contains('SDL2'))">
        <RelativePath>%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Content\**\*.*"
             Exclude="Content\bin\**;Content\obj\**;Content\**\*.mgcb;Content\Music\*.mp3;Content\Shaders\Compiled\*.mgfxo">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb"/>
  </ItemGroup>

</Project>
