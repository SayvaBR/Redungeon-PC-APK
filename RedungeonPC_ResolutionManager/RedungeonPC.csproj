<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <TargetFramework>net10.0</TargetFramework>

    <RollForward>Major</RollForward>

    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <!-- Build only the explicit PC manifest, never Android.mgcb as PC content. -->
    <EnableMGCBItems>false</EnableMGCBItems>

    <!--  -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Facilita o diagnóstico -->
    <MonoGameMGCBAdditionalArguments></MonoGameMGCBAdditionalArguments>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icon.ico"/>
    <None Remove="Icon.bmp"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico"/>
    <EmbeddedResource Include="Icon.bmp"/>
  </ItemGroup>

  <!-- Os contratos executáveis vivem em um projeto separado e não fazem
       parte do binário do jogo. -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs"/>
    <Compile Remove="Android\**\*.cs"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Fixar as versões -->
    <PackageReference Include="MonoGame.Framework.DesktopGL"
                      Version="3.8.5.1"/>

    <PackageReference Include="MonoGame.Content.Builder.Task"
                      Version="3.8.5.1"/>
  </ItemGroup>

  <!--
    SDL2 must sit next to the single-file .exe at publish time.
    The .NET single-file bundler reads ExcludeFromSingleFile BEFORE it packs,
    so we must set it in a target that runs before _GeneratePublishDependencyFile.
    Using AfterTargets="ResolveAssemblyReferences" is the safest hook that
    still has all NuGet-resolved native libs available.
  -->
  <Target Name="ExcludeSDL2FromSingleFile" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <!-- Mark SDL2 native libs so the bundler leaves them as external files. -->
      <ResolvedFileToPublish Include="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'SDL2' or
                                        '%(Filename)' == 'libSDL2-2.0.so' or
                                        '%(Filename)' == 'libSDL2'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Content\**\*.*"
             Exclude="Content\bin\**;Content\obj\**;Content\**\*.mgcb;Content\Music\*.mp3;Content\Shaders\Compiled\*.mgfxo">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb"/>
  </ItemGroup>

</Project>
